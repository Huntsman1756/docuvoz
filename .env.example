# Copy to .env.local and adjust. NEVER commit real credentials.
# All variables are validated at startup (src/server/config.ts); the app
# fails fast with an actionable message on invalid configuration.

# --- Speech provider -------------------------------------------------------
# "mock" (default): deterministic local provider, no network. Use this for
# development, tests and CI.
# "nan": OpenAI-compatible /audio/speech endpoint. DEVELOPMENT / VALIDATION
# INFRASTRUCTURE ONLY — see docs/providers.md before any other use.
SPEECH_PROVIDER=mock

# Required when SPEECH_PROVIDER=nan. Leave blank for mock (blank is treated as
# unset). Fill both to use a real endpoint.
NAN_BASE_URL=
NAN_API_KEY=

# Provider tuning (nan):
NAN_TTS_MODEL=kokoro
NAN_TTS_VOICE=ef_dora
NAN_TTS_FORMAT=mp3

# --- Optional second engine: Edge TTS (unofficial) -------------------------
# Free Microsoft Edge neural voices via the unofficial Edge Read Aloud
# service (no API key, best-effort, not an official Microsoft or Azure
# integration). Shows up as the "Premium" engine in the reader's voice
# picker; noticeably better Spanish. Set to "1" to enable. Uses its own
# pacing pool. See docs/providers.md.
EDGE_TTS_ENABLED=0
EDGE_TTS_VOICE=es-ES-XimenaNeural

# --- Pacing / reliability --------------------------------------------------
# Per-request timeout in ms.
SPEECH_TIMEOUT_MS=30000
# Global provider concurrency cap. Keep at 1 unless the provider plan
# explicitly allows more — aggressive parallelization is an anti-goal.
SPEECH_MAX_CONCURRENCY=1
# Provider-specific pacing: requests per minute converted into a minimum
# inter-request interval (Kokoro plans have their own limits; measure yours).
SPEECH_REQUESTS_PER_MINUTE=20
# Total attempts per synthesis request (retries use exponential backoff).
SPEECH_MAX_ATTEMPTS=3

# --- Cache -----------------------------------------------------------------
SPEECH_CACHE_DIR=.cache/audio

# --- API guards --------------------------------------------------------------
# Max characters accepted per synthesis request (chunks are ~400 chars).
SPEECH_MAX_TEXT_CHARS=600
# Synthesis speed used when the client omits `speed`.
SPEECH_DEFAULT_SPEED=1
# Requests per minute per client for /api/speech.
API_RATE_LIMIT_PER_MINUTE=60
# Max JSON body size for /api/speech, in bytes.
API_MAX_BODY_BYTES=16384

# --- Logging ---------------------------------------------------------------
# Structured JSON logs; document contents are never logged, only fingerprints.
LOG_LEVEL=info
