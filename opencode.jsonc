{
  "$schema": "https://opencode.ai/config.json",

  // DocuVoz (auidionan) - OpenCode + Orca orchestration kit.
  // Single source of truth: agents from the kit merged with the repo's
  // NaN/InferX provider definitions. Do not re-create a parallel opencode.json.

  "model": "nan/glm5.3-flash",
  "small_model": "nan/gemma4",
  "enabled_providers": ["nan", "inferx"],
  "share": "disabled",

  "default_agent": "orchestrator",

  "agent": {
    // --- Kit agents --------------------------------------------------------

    "orchestrator": {
      "mode": "primary",
      "model": "nan/glm5.3-flash",
      "description": "Technical orchestrator for planning, decomposition, verification and delegation.",
      "prompt_file": ".opencode/agents/orchestrator.md",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "allow",
        "task": {
          "*": "deny",
          "executor": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "lsp": "allow",
        "skill": "allow"
      }
    },
    "executor": {
      "mode": "subagent",
      "model": "nan/qwen3.6",
      "description": "Bounded implementation executor. Writes code and tests only under orchestrator contracts.",
      "prompt_file": ".opencode/agents/executor.md",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "deny",
        "lsp": "allow",
        "skill": "deny"
      }
    },

    // Kit: disable default OpenCode agents.
    "build":    { "mode": "primary", "disable": true },
    "plan":     { "mode": "primary", "disable": true },
    "general":  { "mode": "subagent", "disable": true },
    "explore":  { "mode": "subagent", "disable": true },

    // --- Repo legacy subagents (preserved) ---------------------------------

    "nan-code-executor": {
      "mode": "subagent",
      "model": "nan/qwen3.8-flash",
      "description": "NAN qwen3.8-flash code executor. One coding attempt plus at most one repair. No automatic commit/push/publish.",
      "prompt": "You are the NAN code executor (qwen3.8-flash).\n\nConstraints:\n- One coding attempt only, then at most one repair attempt.\n- Do NOT commit, push, or publish automatically.\n- Return code diffs with clear before/after.\n- If repair fails, signal STOP to the orchestrator.\n- budget: respect NAN_TOKEN_BUDGET env var.",
      "steps": 16,
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "task": "deny"
      }
    },
    "nan-bulletin-reviewer": {
      "mode": "subagent",
      "model": "nan/gemma4",
      "description": "NAN gemma4 structured bulletin reviewer. No tools. Prompt-only input, JSON output.",
      "prompt": "You are the NAN structured bulletin reviewer (gemma4).\n\nConstraints:\n- NO tools available. Input only via prompt text.\n- Read the full bulletin record in the prompt.\n- Return structured JSON (schema validation required).\n- Cannot publish, cannot use tools, cannot commit.",
      "temperature": 0.6,
      "top_p": 0.95,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "fallback-code-1": {
      "mode": "subagent",
      "model": "nan/deepseek-v4-flash",
      "description": "Fallback code executor #1 (DeepSeek V4 Flash, vision-exp). Only after ChatGPT explicit approval.",
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "fallback-code-2": {
      "mode": "subagent",
      "model": "nan/mimo-v2.5",
      "description": "Fallback code executor #2 (MiMo V2.5). Only after ChatGPT explicit approval and deepseek failure.",
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    }
  },

  "provider": {
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN Builders",
      "options": {
        "baseURL": "https://api.nan.builders/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "glm5.3-flash": {
          "name": "GLM 5.3 Flash (NaN) - Main · multimodal · reasoning · 1M ctx",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen3.6": {
          "name": "Qwen 3.6 (NaN) - Kit executor · 262K ctx · vision",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen3.8-flash": {
          "name": "Qwen 3.8 Flash (NaN) - Executor · 262K ctx · vision",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (NaN) - Fallback #1 · vision-exp · 1M ctx",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "mimo-v2.5": {
          "name": "Xiaomi MiMo V2.5 (NaN) - Fallback #2 · omnimodal · 1M ctx",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image", "audio"],
            "output": ["text"]
          }
        },
        "gemma4": {
          "name": "Gemma 4 (NaN) - Review / small_model · community · temp 0.6/top_p 0.95",
          "reasoning": true,
          "tool_call": false,
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "inferx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "InferX Shared",
      "options": {
        "baseURL": "https://model.inferx.net/endpoints/v1",
        "apiKey": "{env:INFERX_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 120000,
        "headers": {
          "X-Tenant": "quickstart-inference-tn-13dymq02pr"
        }
      },
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen 3.8 Flash Next (InferX) · 262K ctx",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 50000
  },

  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "__pycache__/**",
      ".venv/**",
      ".worktrees/**",
      ".agent-runs/**",
      ".tmp/**",
      ".orca-local/**",
      ".orca-tools/**",
      ".tickets/**",
      ".opencode/node_modules/**",
      "src-tauri/target/**",
      ".next/**",
      "test-results/**",
      "playwright-report/**"
    ]
  }
}
