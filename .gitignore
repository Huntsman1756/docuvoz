# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local runtime artifacts (dev server scratch, audio cache, e2e traces)
.tmp/
.cache/
.cache-server*.log
/test-results/
/playwright-report/
/playwright/.cache/

# desktop (Tauri) build artifacts
/sidecar/dist/
/desktop/.next/
/desktop/out/
/desktop/public/
/desktop/tsconfig.tsbuildinfo/
/src-tauri/target/
/src-tauri/binaries/
/src-tauri/gen/schemas/

# pdf.js assets are copied from node_modules by `npm run setup:pdfjs`
/public/pdfjs/

# locally-held real-world corpus documents (never committed)
evaluation/corpus/local/

# experiment working data: audio + answer keys are regenerable or private
# (blinding requires private/ never being published)
evaluation/experiments/*/audio/
evaluation/experiments/*/private/
# G3a WAV stimuli are intentionally NOT committed: redistribution rights for
# NaN-generated audio are unconfirmed (provider ToS silent on outputs).
# Stimulus identity is pinned by the SHA-256 values in
# evaluation/experiments/g3a/manifest.json; binaries live in the private kit.

# Orca kit: generated entries

.orca-local/

.orca-tools/

.opencode/node_modules/

.tickets/

