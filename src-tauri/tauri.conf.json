{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocuVoz",
  "version": "0.2.0-beta.1",
  "identifier": "com.docuvoz.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../desktop/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DocuVoz",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/docuvoz-speech"],
    "resources": {
      "LICENSE": "licenses/LICENSE",
      "NOTICE.md": "licenses/NOTICE.md",
      "THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    }
  }
}
